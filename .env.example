# Copy to .env (ignored by git). Commercial Breaker sends audio only to Google Vertex AI and
# authenticates with Application Default Credentials; no API key is used.
GOOGLE_CLOUD_PROJECT=your-project-id
# Optional. Defaults to global, which serves current Gemini models.
GOOGLE_CLOUD_LOCATION=global
# Optional. Meters requests against this project instead of the Mac-wide ADC
# quota project, which other apps may set. Usually the same as GOOGLE_CLOUD_PROJECT.
# GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id
# Optional. The app sets these for each worker it launches; override only when running
# Tools/gemini-live-worker.mjs by hand. Sport is football or ufc; return detection is 1 or 0.
# COMMERCIAL_BREAKER_SPORT=football
# COMMERCIAL_BREAKER_RETURN_DETECTION=0
