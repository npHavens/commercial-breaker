# Copy to .env (ignored by git). Skybox sends audio only to Google Vertex AI and
# authenticates with Application Default Credentials; no API key is used.
GOOGLE_CLOUD_PROJECT=your-project-id
# Optional. Defaults to global, which serves current Gemini models.
GOOGLE_CLOUD_LOCATION=global
# Optional. Meters requests against this project instead of the Mac-wide ADC
# quota project, which other apps may set. Usually the same as GOOGLE_CLOUD_PROJECT.
# GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id
